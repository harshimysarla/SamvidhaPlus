# ==============================================================================
# SamvidhaPlus – Environment Configuration
# Tagline: Understand Your Performance. Predict Your Progress. Shape Your Future.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Add to Vercel / .env.local)
# ------------------------------------------------------------------------------
# In production, replace with your deployed backend URL (Render / Railway / Fly.io / EC2)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
BACKEND_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Add to Backend Host / .env)
# ------------------------------------------------------------------------------
PROJECT_NAME="SamvidhaPlus – AI-Powered Academic Intelligence Platform"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Cryptographic Secret for JWT Session Tokens
SECRET_KEY="samvidhaplus-super-secure-production-cryptographic-secret-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite by default; use PostgreSQL in production)
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@host:5432/samvidhaplus_db"
DATABASE_URL="sqlite:///./saip_database.db"

# Data Provider Mode: "Demo Data", "Authorized Import", or "Official API"
ACTIVE_DATA_PROVIDER="Demo Data"

# Official College API Credentials (Optional / Future Integration)
OFFICIAL_API_BASE_URL=""
OFFICIAL_API_CLIENT_ID=""
OFFICIAL_API_SECRET=""

# Academic Regulations & Thresholds
ATTENDANCE_REGULAR_THRESHOLD=75.0
ATTENDANCE_CONDONATION_THRESHOLD=65.0
