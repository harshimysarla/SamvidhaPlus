# --- SAIP Configuration Environment Template ---

# Backend Settings
PROJECT_NAME="Smart Academic Intelligence Portal (SAIP)"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-with-a-random-cryptographic-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default; use postgresql://user:pass@host:5432/dbname for PostgreSQL)
DATABASE_URL="sqlite:///./saip_database.db"

# Data Provider Integration
# Options: "Demo Data", "Authorized Import", "Official API"
ACTIVE_DATA_PROVIDER="Demo Data"

# Official Samvidha API Credentials (Provisioned by College IT Administration)
OFFICIAL_API_BASE_URL=""
OFFICIAL_API_CLIENT_ID=""
OFFICIAL_API_SECRET=""

# Academic Rules
ATTENDANCE_REGULAR_THRESHOLD=75.0
ATTENDANCE_CONDONATION_THRESHOLD=65.0

# Frontend Settings
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
